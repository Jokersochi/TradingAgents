# Research and paper decisions only. Never place broker/exchange credentials here.
# This file contains no secrets. Copy it to .env on your own machine.
# The ChatGPT provider requires a one-time local browser sign-in:
#   tradingagents login chatgpt
TRADINGAGENTS_LLM_PROVIDER=chatgpt
TRADINGAGENTS_QUICK_THINK_LLM=gpt-6-luna
TRADINGAGENTS_DEEP_THINK_LLM=gpt-6-sol
TRADINGAGENTS_OUTPUT_LANGUAGE=Russian
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_MAX_TOOL_ROUNDS=8
TRADINGAGENTS_CHECKPOINT_ENABLED=false
TRADINGAGENTS_NO_UPDATE_CHECK=1
